# 复制为 .env 后填写真实值（注意：不要提交到 git）

# 服务监听端口
PORT=8080

# 监听地址。127.0.0.1 表示只给本机 nginx 转发，不直接对外
HOST=127.0.0.1

# 注册邀请码。设置后，别人注册必须填这个码
# 建议设置，否则任何人知道你的地址就能注册账号
REGISTER_CODE=change-me

# ---------- AI「一句话记账」 ----------
# 不填则 AI 输入框自动隐藏，其他功能不受影响
#
# 方式一：通义千问 / 阿里云百炼（推荐，国内直连、无需代理）
#   申请地址：https://bailian.console.aliyun.com/  → API-KEY
QWEN_API_KEY=
# AI_MODEL=qwen3.8-max
#
# 方式二：任意 OpenAI 兼容服务（DeepSeek、豆包、智谱等）
# AI_API_KEY=
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
#
# 推理模型的思考开关。qwen3.8-max 这类模型默认关（记账不需要推理，关掉约快 4 倍）
# AI_THINKING=off

# 兼容旧配置，等同 AI_API_KEY + DeepSeek 默认地址
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 数据文件存放目录，默认 ./data
# DATA_DIR=/var/lib/ledger

# 备案号。填了才会在页面底部显示，绑域名对外访问时按工信部要求必须展示
# 填写格式与备案系统一致，例如：京ICP备2026000000号-1
ICP_BEIAN=
