# 复制为 .env 后填写真实值（注意：不要提交到 git）

# 服务监听端口
PORT=8080

# 注册邀请码。设置后，别人注册必须填这个码
# 建议设置，否则任何人知道你的地址就能注册账号
REGISTER_CODE=change-me

# DeepSeek API Key（用于「一句话记账」功能）
# 不填则 AI 功能自动隐藏，其他功能不受影响
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 可选：换用兼容 OpenAI 协议的国内服务
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 数据文件存放目录，默认 ./data
# DATA_DIR=/var/lib/ledger
